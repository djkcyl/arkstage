# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Tauri
src-tauri/target/
# Generated capability schemas (regenerated by tauri build); not source.
src-tauri/gen/schemas/
# Apple scaffold (not building iOS); ignore if/when generated.
src-tauri/gen/apple/
# NOTE: src-tauri/gen/android IS version-controlled (it holds customizable
# Gradle/manifest/signing files). Its own src-tauri/gen/android/.gitignore
# excludes the build outputs (app/build, .gradle, .cxx, local.properties).

# Local build outputs (installers copied to the project root by scripts/build-*.sh)
/*.exe
/*.msi
/*.deb
/*.rpm
/*.AppImage
/*.dmg
/*.zip

# Portable build output (scripts/build-windows-portable.sh)
/prts-reader-portable/
prts-reader-portable.zip

# Reference files (downloaded for analysis)
_reference/

# Scratch artifacts dropped at the repo root while debugging (screenshots, logs).
# scripts/precommit-clean.sh also removes these before a commit.
/error.txt
/image.png
/image*.png
/screenshot*.png

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.playwright-mcp/
